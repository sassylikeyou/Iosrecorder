<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#000000"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp" />

        <!-- App Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_stat_card"
            android:padding="14dp"
            android:gravity="center_vertical">
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_rec_btn"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:layout_gravity="center"
                    app:tint="#FFFFFF" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ScreenRec" android:textColor="#000" android:textStyle="bold" android:textSize="17sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Version 2.1.0" android:textColor="#999" android:textSize="13sp" android:layout_marginTop="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100% FREE · NO ADS" android:textColor="#34C759" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Video Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO"
            android:textColor="#999"
            android:textSize="13sp"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_card"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp">
            
            <!-- Resolution -->
            <LinearLayout android:id="@+id/row_resolution" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Resolution" android:textColor="#000" android:textSize="17sp" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/val_resolution" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1080p HD" android:textColor="#999" android:textSize="17sp" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#ccc" android:textSize="17sp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1E3C3C43" android:layout_marginStart="52dp"/>

            <!-- Frame Rate -->
            <LinearLayout android:id="@+id/row_fps" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Frame Rate" android:textColor="#000" android:textSize="17sp" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/val_fps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60 fps" android:textColor="#999" android:textSize="17sp" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#ccc" android:textSize="17sp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1E3C3C43" android:layout_marginStart="52dp"/>

            <!-- Bitrate -->
            <LinearLayout android:id="@+id/row_bitrate" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Bitrate" android:textColor="#000" android:textSize="17sp" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/val_bitrate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8 Mbps" android:textColor="#999" android:textSize="17sp" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#ccc" android:textSize="17sp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1E3C3C43" android:layout_marginStart="52dp"/>

            <!-- Format -->
            <LinearLayout android:id="@+id/row_format" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Format" android:textColor="#000" android:textSize="17sp" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/val_format" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MP4" android:textColor="#999" android:textSize="17sp" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#ccc" android:textSize="17sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- AUDIO Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUDIO"
            android:textColor="#999"
            android:textSize="13sp"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_card"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="6dp">
            
            <LinearLayout android:id="@+id/row_mic" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Microphone" android:textColor="#000" android:textSize="17sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Internal" android:textColor="#999" android:textSize="12sp"/>
                </LinearLayout>
                <Switch android:id="@+id/switch_mic" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
             <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#1F3C3C43" android:layout_marginStart="52dp"/>
            
            <LinearLayout android:id="@+id/row_sys_audio" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="System Audio" android:textColor="#000" android:textSize="17sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Device sounds" android:textColor="#999" android:textSize="12sp"/>
                </LinearLayout>
                <Switch android:id="@+id/switch_sys_audio" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System audio requires Android 10 or later."
            android:textColor="#999"
            android:textSize="13sp"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>
