<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginTop="48dp" />

        <!-- Video Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIDEO"
            android:textColor="#A1A1AA"
            android:textSize="13sp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_card"
            android:layout_marginHorizontal="16dp"
            android:elevation="0dp">
            
            <!-- Resolution -->
            <LinearLayout android:id="@+id/row_resolution" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_crop" app:tint="#8B5CF6" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Resolution" android:textColor="#FFFFFF" android:textSize="17sp" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/val_resolution" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1080p (FHD)" android:textColor="#A1A1AA" android:textSize="17sp" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#C7C7CC" android:textSize="17sp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#38383A" android:layout_marginStart="56dp"/>

            <!-- Frame Rate -->
            <LinearLayout android:id="@+id/row_fps" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_recent_history" app:tint="#3B82F6"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Frame Rate" android:textColor="#FFFFFF" android:textSize="17sp" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/val_fps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60 FPS" android:textColor="#A1A1AA" android:textSize="17sp" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#C7C7CC" android:textSize="17sp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#38383A" android:layout_marginStart="56dp"/>

            <!-- Countdown Timer -->
            <LinearLayout android:id="@+id/row_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_agenda" app:tint="#10B981"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Countdown" android:textColor="#FFFFFF" android:textSize="17sp" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/val_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3s" android:textColor="#A1A1AA" android:textSize="17sp" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#C7C7CC" android:textSize="17sp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#38383A" android:layout_marginStart="56dp"/>

            <!-- Bitrate -->
            <LinearLayout android:id="@+id/row_bitrate" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#F97316"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Bitrate" android:textColor="#FFFFFF" android:textSize="17sp" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/val_bitrate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 Mbps" android:textColor="#A1A1AA" android:textSize="17sp" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#C7C7CC" android:textSize="17sp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#38383A" android:layout_marginStart="56dp"/>

            <!-- Video Encoder -->
            <LinearLayout android:id="@+id/row_encoder" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:background="?actionBarItemBackground">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_camera" app:tint="#8B5CF6"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Video Encoder" android:textColor="#FFFFFF" android:textSize="17sp" android:layout_marginStart="12dp"/>
                    <TextView android:id="@+id/val_encoder" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="H.264" android:textColor="#A1A1AA" android:textSize="17sp" android:layout_marginEnd="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#C7C7CC" android:textSize="17sp"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HEVC reduces file size but may not be compatible with older devices." android:textColor="#A1A1AA" android:textSize="11sp" android:layout_marginStart="40dp" android:layout_marginTop="2dp" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#38383A" android:layout_marginStart="56dp"/>

            <!-- Max File Size -->
            <LinearLayout android:id="@+id/row_max_file_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_manage" app:tint="#F43F5E"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Max File Size" android:textColor="#FFFFFF" android:textSize="17sp" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/val_max_file_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No Limit" android:textColor="#A1A1AA" android:textSize="17sp" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#C7C7CC" android:textSize="17sp"/>
            </LinearLayout>
        </LinearLayout>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Higher settings may increase file size."
            android:textColor="#A1A1AA"
            android:textSize="13sp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_card"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp">
            
            <LinearLayout android:id="@+id/row_mic" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_btn_speak_now" app:tint="#8B5CF6"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Audio Source" android:textColor="#FFFFFF" android:textSize="17sp" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/val_audio_source" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Microphone" android:textColor="#A1A1AA" android:textSize="17sp" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#C7C7CC" android:textSize="17sp"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#38383A" android:layout_marginStart="56dp"/>

            <LinearLayout android:id="@+id/row_show_touches" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_edit" app:tint="#3B82F6"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Show Touches" android:textColor="#FFFFFF" android:textSize="17sp" android:layout_marginStart="12dp"/>
                <Switch android:id="@+id/switch_show_touches" android:layout_width="wrap_content" android:layout_height="wrap_content" android:thumbTint="#FFFFFF" android:trackTint="#3B82F6" />
            </LinearLayout>
        </LinearLayout>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record microphone audio or show screen touches while recording. (Show Touches requires system modify permission)"
            android:textColor="#A1A1AA"
            android:textSize="13sp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APPEARANCE"
            android:textColor="#A1A1AA"
            android:textSize="13sp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_card"
            android:layout_marginHorizontal="16dp"
            android:elevation="0dp">
            
            <LinearLayout android:id="@+id/row_theme" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:background="?actionBarItemBackground">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_view" app:tint="#10B981" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="App Theme" android:textColor="#FFFFFF" android:textSize="17sp" android:layout_marginStart="12dp"/>
                <TextView android:id="@+id/val_theme" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="System Default" android:textColor="#A1A1AA" android:textSize="17sp" android:layout_marginEnd="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#C7C7CC" android:textSize="17sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- About Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABOUT"
            android:textColor="#A1A1AA"
            android:textSize="13sp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_stat_card"
            android:padding="14dp"
            android:gravity="center_vertical">
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_stats_dark"
                android:layout_marginEnd="14dp">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_record_circle"
                    android:layout_gravity="center"
                    app:tint="#FF3B30" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Screen Recorder" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="17sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Record your screen" android:textColor="#A1A1AA" android:textSize="13sp" android:layout_marginTop="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="v1.2.0" android:textColor="#8B5CF6" android:background="#208B5CF6" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:textSize="11sp" android:layout_marginTop="4dp" android:textStyle="bold" />
            </LinearLayout>
             <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">" android:textColor="#C7C7CC" android:textSize="17sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_export_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_stat_card"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical"
            android:elevation="0dp">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_save" app:tint="#3B82F6" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Export Codebase (ZIP)" android:textColor="#FFFFFF" android:textSize="17sp" android:layout_marginStart="12dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_reset_defaults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_stat_card"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical"
            android:elevation="0dp">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_revert" app:tint="#EF4444" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Reset to Defaults" android:textColor="#EF4444" android:textSize="17sp" android:layout_marginStart="12dp"/>
        </LinearLayout>

        <Switch android:id="@+id/switch_sys_audio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        <View android:id="@+id/row_format" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
        <TextView android:id="@+id/val_format" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
